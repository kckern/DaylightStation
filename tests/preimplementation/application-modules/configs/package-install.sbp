(version 1)
(allow default)
(deny network*)
(deny process-exec)
(allow process-exec (literal (param "NODE_BINARY")))
(deny file-write*)
(allow file-write* (subpath (param "RUN_ROOT")))
(deny file-read-data
  (subpath "/Users") (subpath "/Volumes") (subpath "/private/tmp")
  (subpath "/private/var/folders") (subpath "/data") (subpath "/media"))
(allow file-read-data
  (subpath (param "WORKTREE"))
  (subpath (param "ROOT_DEPS"))
  (subpath (param "BACKEND_DEPS"))
  (subpath (param "FRONTEND_DEPS"))
  (subpath (param "RUN_ROOT"))
  (subpath "/opt/homebrew") (subpath "/System") (subpath "/Library")
  (subpath "/usr") (subpath "/private/etc")
  (literal "/dev/null") (literal "/dev/urandom") (literal "/dev/random"))
