  "patterns": [
    {
      "id": "concession",
      "label": "-아/어도",
      "explanation": "Connect a verb or adjective with -아/어도 to say “even if/even though.” The second clause still holds despite the first. This is concession; -아/어도 되다 adds permission. 하다 becomes 해도. Review of Lesson 7.",
      "source": {
        "book": "textbook",
        "page": 78
      },
      "models": [
        {
          "id": "repeat-book",
          "term": "여러 번 읽어도 재미있어요.",
          "gloss": "Even after reading it several times, it is interesting.",
          "source": {
            "book": "textbook",
            "page": 98
          },
          "pronunciation": "Yeoreo beon ilgeodo jaemiisseoyo."
        }
      ],
      "questions": [
        {
          "id": "concession-01",
          "modelId": "repeat-book",
          "explanation": "아무리 … -아/어도 emphasizes “no matter how much.”",
          "formA": {
            "prompt": "Even if I search, I cannot find it: 아무리 ___ 지갑이 안 보여요.",
            "choices": [
              "찾아도",
              "찾으면서",
              "찾느라고",
              "찾기 때문에"
            ],
            "answer": "찾아도"
          },
          "formB": {
            "prompt": "Even if I think hard, I do not know: 아무리 ___ 모르겠어요.",
            "choices": [
              "생각하면서",
              "생각하느라고",
              "생각하기 때문에",
              "생각해도"
            ],
            "answer": "생각해도"
          }
        },
        {
          "id": "concession-02",
          "modelId": "repeat-book",
          "explanation": "The second statement remains true despite the first.",
          "formA": {
            "prompt": "Even if I am busy, I keep promises: ___ 약속을 지켜요.",
            "choices": [
              "바빠서",
              "바쁘면",
              "바쁘기 때문에",
              "바빠도"
            ],
            "answer": "바빠도"
          },
          "formB": {
            "prompt": "Even though the book is long, it is fun: 책이 ___ 재미있어요.",
            "choices": [
              "길면",
              "길기 때문에",
              "길어도",
              "길어서"
            ],
            "answer": "길어도"
          }
        }
      ]
    },
    {
      "id": "wish",
      "label": "-(으)면 좋겠다",
      "explanation": "Use -(으)면 좋겠다 to express a wish: “I hope…” or “It would be nice if….” Add -으면 after a consonant and -면 after a vowel or ㄹ; apply irregular stem changes. 좋겠어요 is polite; 좋겠어 is familiar. Review of Lesson 7.",
      "source": {
        "book": "textbook",
        "page": 79
      },
      "models": [
        {
          "id": "puppy-wish",
          "term": "우리 집에도 강아지가 있으면 좋겠어요.",
