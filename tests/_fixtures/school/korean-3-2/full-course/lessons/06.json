            "answer": "간대요"
          },
          "formB": {
            "prompt": "Report “plays with a friend”: 친구하고 ___.",
            "choices": [
              "논대요",
              "놀는대요",
              "노는대요",
              "놀아요"
            ],
            "answer": "논대요"
          }
