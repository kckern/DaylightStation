        }
      ],
      "questions": [
        {
          "id": "report-statement-01",
          "modelId": "not-cucumber",
          "explanation": "Present action stems with a consonant take -는대요.",
          "formA": {
            "prompt": "Report “does not eat”: 우진이가 오이를 안 ___.",
            "choices": [
              "먹는대요",
              "먹대요",
              "먹은대요",
              "먹어요"
            ],
            "answer": "먹는대요"
          },
          "formB": {
            "prompt": "Report “reads a book”: 지연이가 책을 ___.",
            "choices": [
              "읽는대요",
              "읽대요",
              "읽은대요",
              "읽어요"
            ],
            "answer": "읽는대요"
          }
        },
        {
          "id": "report-statement-02",
          "modelId": "museum",
          "explanation": "Vowel stems take -ㄴ대요; ㄹ drops, so 놀다 becomes 논대요.",
          "formA": {
            "prompt": "Report “goes to a museum”: 박물관으로 ___.",
            "choices": [
              "간대요",
              "가는대요",
              "가대요",
              "가요"
