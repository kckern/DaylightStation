          "formB": {
            "prompt": "Fear forgetting: 약속을 ___ 수첩에 적었어.",
            "choices": [
              "잊어버릴까 봐",
              "잊어버리느라고",
              "잊어버린대요",
              "잊어버려도 돼서"
