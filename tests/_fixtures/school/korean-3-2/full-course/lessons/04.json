          "formB": {
            "prompt": "Fear cold weather: 날씨가 ___ 목도리를 가져왔어.",
            "choices": [
              "추울까 봐",
              "춥느라고",
              "춥는대요",
              "추워도 돼서"
            ],
            "answer": "추울까 봐"
          }
        },
        {
          "id": "worried-03",
          "modelId": "rain-fear",
          "explanation": "Use -(으)ㄹ까 봐 for prevention of an unwanted future event.",
