            "page": 79
          },
          "pronunciation": "Hayan nuni omyeon jokesseo."
        }
      ],
      "questions": [
        {
          "id": "wish-01",
          "modelId": "jeju-wish",
          "explanation": "-면 좋겠다 expresses a wish, not a report or permission.",
          "formA": {
