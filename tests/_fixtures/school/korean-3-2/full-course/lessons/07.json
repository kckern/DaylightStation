  "patterns": [
    {
      "id": "concession",
      "label": "-아/어도",
      "explanation": "Connect a verb or adjective with -아/어도 to say “even if/even though.” The second clause still holds despite the first. This is concession; -아/어도 되다 adds permission. 하다 becomes 해도.",
      "source": {
        "book": "textbook",
        "page": 78
      },
      "models": [
        {
          "id": "short-basketball",
          "term": "키가 작아도 농구를 잘해요.",
          "gloss": "Even though he is short, he plays basketball well.",
          "source": {
            "book": "textbook",
            "page": 78
          },
          "pronunciation": "Kiga jagado nonggureul jalhaeyo."
        },
        {
          "id": "repeat-book",
          "term": "여러 번 읽어도 재미있어요.",
          "gloss": "Even after reading it several times, it is interesting.",
          "source": {
            "book": "textbook",
            "page": 78
          },
          "pronunciation": "Yeoreo beon ilgeodo jaemiisseoyo."
        },
        {
          "id": "slow-okay",
          "term": "천천히 가도 괜찮아.",
          "gloss": "It is okay even if we go slowly.",
          "source": {
            "book": "textbook",
            "page": 78
          },
          "pronunciation": "Cheoncheonhi gado gwaenchana."
        }
      ],
      "questions": [
        {
          "id": "concession-01",
          "modelId": "short-basketball",
          "explanation": "작다 → 작아도; the height does not prevent good basketball.",
          "formA": {
            "prompt": "Even though he is short: 키가 ___ 농구를 잘해요.",
            "choices": [
              "작아도",
              "작아서",
              "작으면",
              "작느라고"
            ],
            "answer": "작아도"
          },
          "formB": {
            "prompt": "Even though the shoes are expensive: 운동화가 ___ 사고 싶어요.",
            "choices": [
              "비싸서",
              "비싸면",
              "비싸느라고",
              "비싸도"
            ],
            "answer": "비싸도"
          }
        },
        {
          "id": "concession-02",
          "modelId": "repeat-book",
          "explanation": "-어도 marks a result holding despite repetition or difficulty.",
          "formA": {
            "prompt": "Even after reading it repeatedly: 여러 번 ___ 재미있어요.",
            "choices": [
              "읽으면",
              "읽느라고",
              "읽기 때문에",
              "읽어도"
            ],
            "answer": "읽어도"
          },
          "formB": {
            "prompt": "Even if homework is hard: 숙제가 ___ 열심히 할 거예요.",
            "choices": [
              "힘들면",
              "힘들기 때문에",
              "힘들어도",
              "힘들어서"
            ],
            "answer": "힘들어도"
          }
        },
        {
          "id": "concession-03",
          "modelId": "slow-okay",
          "explanation": "Concession permits the second clause to hold even under the first condition.",
          "formA": {
            "prompt": "It is okay even if we go slowly: 천천히 ___ 괜찮아.",
            "choices": [
              "가면서",
              "갔기 때문에",
              "가도",
              "가느라고"
            ],
            "answer": "가도"
          },
          "formB": {
            "prompt": "Even if it rains, I will exercise: 비가 ___ 운동할 거예요.",
            "choices": [
              "오느라고",
              "와도",
              "오기 때문에",
              "오면서"
            ],
            "answer": "와도"
          }
        }
      ]
    },
    {
      "id": "wish",
      "label": "-(으)면 좋겠다",
      "explanation": "Use -(으)면 좋겠다 to express a wish: “I hope…” or “It would be nice if….” Add -으면 after a consonant and -면 after a vowel or ㄹ; apply irregular stem changes. 좋겠어요 is polite; 좋겠어 is familiar.",
      "source": {
        "book": "textbook",
        "page": 79
      },
      "models": [
        {
          "id": "jeju-wish",
