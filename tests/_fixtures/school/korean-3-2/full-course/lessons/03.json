            "answer": "간 것 같아요"
          }
        },
        {
          "id": "seems-03",
          "modelId": "rain-soon",
          "explanation": "Predictions take -(으)ㄹ 것 같다, even with adjectives.",
          "formA": {
            "prompt": "Predict future rain: 곧 비가 ___.",
            "choices": [
              "올 것 같아요",
              "온 것 같아요",
              "오는대요",
              "와도 돼요"
            ],
            "answer": "올 것 같아요"
          },
          "formB": {
            "prompt": "Predict a future crowd: 내일 사람이 ___. (many)",
            "choices": [
              "많을 것 같아요",
              "많은 것 같아요",
              "많는 것 같아요",
              "많았대요"
            ],
