      ],
      "questions": [
        {
          "id": "seems-01",
          "modelId": "ate-cake",
          "explanation": "Past action inference uses -(으)ㄴ 것 같다.",
          "formA": {
            "prompt": "Infer a completed action: 케이크를 다 ___. (ate)",
            "choices": [
              "먹은 것 같아요",
              "먹는 것 같아요",
              "먹을 것 같아요",
