  "patterns": [
    {
      "id": "background",
      "label": "-는/(으)ㄴ데",
      "explanation": "Use -는데 with present verbs and 있다/없다, and -(으)ㄴ데 with present adjectives, to give background for a following question, request or statement. Nouns take -인데; past forms take -았/었는데. This connective introduces context; it does not itself mark a reason or goal.",
      "source": {
        "book": "textbook",
        "page": 108
      },
      "models": [
        {
          "id": "stomach-request",
          "term": "배가 아픈데 일찍 가도 돼요?",
          "gloss": "My stomach hurts; may I leave early?",
          "source": {
            "book": "textbook",
            "page": 108
          },
          "pronunciation": "Baega apeunde iljjik gado dwaeyo?"
        },
        {
          "id": "medicine-context",
          "term": "매일 약을 먹는데 병원에 또 가야 해요?",
          "gloss": "I take medicine every day; do I need to go to the hospital again?",
          "source": {
            "book": "textbook",
            "page": 108
          },
          "pronunciation": "Maeil yageul meongneunde byeongwone tto gaya haeyo?"
        },
        {
          "id": "cough-mask",
          "term": "기침을 계속 하는데 마스크를 쓰는 게 좋겠어.",
          "gloss": "You keep coughing, so… it would be good to wear a mask.",
          "source": {
            "book": "textbook",
            "page": 108
          },
          "pronunciation": "Gichimeul gyesok haneunde maseukeureul sseuneun ge jokesseo."
        }
      ],
      "questions": [
        {
          "id": "background-01",
          "modelId": "stomach-request",
          "explanation": "아프다 is an adjective with a vowel-final stem: 아픈데.",
          "formA": {
            "prompt": "Give background for a request: 배가 ___ 일찍 가도 돼요?",
            "choices": [
              "아픈데",
              "아프는데",
              "아프은데",
              "아프는지"
            ],
            "answer": "아픈데"
          },
          "formB": {
            "prompt": "Give cold weather as background: 날씨가 ___ 옷을 얇게 입었어요?",
            "choices": [
              "춥는데",
              "춥은데",
              "추우는지",
              "추운데"
            ],
            "answer": "추운데"
          }
        },
        {
          "id": "background-02",
          "modelId": "medicine-context",
          "explanation": "A present action verb uses -는데, unlike a regular adjective.",
          "formA": {
            "prompt": "Give daily medicine-taking as context: 매일 약을 ___ 병원에 또 가야 해요?",
            "choices": [
              "먹은데",
              "먹ㄴ데",
              "먹는지",
              "먹는데"
            ],
            "answer": "먹는데"
          },
          "formB": {
            "prompt": "Give going to the shop as context: 슈퍼에 ___ 뭐 사다 줄까?",
            "choices": [
              "가은데",
              "가는지",
              "가는데",
              "간데"
            ],
            "answer": "가는데"
          }
        },
        {
          "id": "background-03",
          "modelId": "cough-mask",
          "explanation": "Background -는데 is distinct from concession, simultaneous action and a goal.",
          "formA": {
            "prompt": "Use background -는데 (not “while” or “even if”): 기침을 계속 ___ 마스크를 쓰는 게 좋겠어.",
            "choices": [
              "하면서",
              "해도",
              "하는데",
              "하려면"
            ],
            "answer": "하는데"
          },
          "formB": {
            "prompt": "Use background -는데 (not “while” or “even if”): 태권도를 ___ 정말 재미있어.",
            "choices": [
              "배워도",
              "배우는데",
              "배우려면",
              "배우면서"
            ],
            "answer": "배우는데"
          }
        }
      ]
    },
    {
      "id": "experience",
      "label": "-아/어 보다",
      "explanation": "Use a verb with -아/어 보다 to describe trying an action. For an experience already had, use -아/어 봤어요 (familiar: 봤어); a negative experience can be 아직 안 … 봤어요. 하다 becomes 해 보다. This lesson focuses on experience, not an adjective’s appearance.",
      "source": {
        "book": "textbook",
        "page": 109
      },
      "models": [
        {
          "id": "hospital-experience",
          "term": "병원에는 가 봤어?",
          "gloss": "Have you been to the hospital?",
          "source": {
            "book": "textbook",
            "page": 109
          },
          "pronunciation": "Byeongwoneneun ga bwasseo?"
        },
        {
          "id": "bulgogi-experience",
          "term": "나도 먹어 봤어.",
          "gloss": "I have tried eating it too.",
          "source": {
            "book": "textbook",
            "page": 109
          },
          "pronunciation": "Nado meogeo bwasseo."
        },
        {
          "id": "photo-experience",
          "term": "아빠 카메라로 찍어 봤어.",
          "gloss": "I have tried taking photos with Dad’s camera.",
          "source": {
            "book": "textbook",
            "page": 109
          },
          "pronunciation": "Appa kameraro jjigeo bwasseo."
        }
      ],
      "questions": [
        {
          "id": "experience-01",
          "modelId": "hospital-experience",
          "explanation": "Past -아/어 봤어요 asks about or states an experience.",
          "formA": {
            "prompt": "Ask about a past hospital experience: 병원에 ___?",
            "choices": [
              "가 보여요",
              "가면 좋겠어요",
              "가야 돼요",
              "가 봤어요"
            ],
            "answer": "가 봤어요"
          },
          "formB": {
            "prompt": "Ask about a past flight experience: 비행기를 ___?",
            "choices": [
              "타면 좋겠어요",
              "타야 돼요",
              "타 봤어요",
              "타 보여요"
            ],
            "answer": "타 봤어요"
          }
        },
        {
          "id": "experience-02",
          "modelId": "bulgogi-experience",
          "explanation": "Distinguish having tried something from permission, plans or appearance.",
          "formA": {
            "prompt": "I have tried bulgogi too: 저도 불고기를 ___.",
            "choices": [
              "먹을 거예요",
              "먹어 보여요",
              "먹어 봤어요",
              "먹어도 돼요"
            ],
            "answer": "먹어 봤어요"
          },
          "formB": {
            "prompt": "I have listened to Korean songs: 한국 노래를 ___.",
            "choices": [
              "들어 보여요",
              "들어 봤어요",
              "들어도 돼요",
              "들을 거예요"
            ],
            "answer": "들어 봤어요"
          }
        },
        {
          "id": "experience-03",
          "modelId": "photo-experience",
          "explanation": "An experience uses -아/어 봤어요; 하다 becomes 해 봤어요.",
          "formA": {
            "prompt": "I have tried taking photos: 사진을 ___ 봤어요.",
            "choices": [
              "찍으면",
              "찍어",
              "찍아",
              "찍는"
            ],
            "answer": "찍어"
          },
          "formB": {
            "prompt": "I have tried exercising: 운동을 ___ 봤어요.",
            "choices": [
              "해",
              "하아",
              "하는",
              "하면"
            ],
            "answer": "해"
          }
        }
      ]
    }
  ]
}
