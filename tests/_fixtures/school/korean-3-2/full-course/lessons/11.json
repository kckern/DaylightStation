  "patterns": [
    {
      "id": "goal-condition",
      "label": "-(으)려면",
      "explanation": "Use -(으)려면 to introduce a desired goal and the condition or action needed to reach it: “If you want to….” Add -으려면 after a consonant and -려면 after a vowel or ㄹ. Adjective examples describe a desired change or outcome, such as 키가 크려면. A following clause often gives advice or a requirement.",
      "source": {
        "book": "textbook",
        "page": 118
      },
      "models": [
        {
          "id": "strong-goal",
          "term": "튼튼해지려면 운동을 열심히 해야 돼.",
          "gloss": "If you want to become strong, you need to exercise diligently.",
          "source": {
            "book": "textbook",
            "page": 118
          },
          "pronunciation": "Teunteunhaejiryeomyeon undongeul yeolsimhi haeya dwae."
        },
        {
          "id": "read-goal",
          "term": "책을 읽으려면 책상에서 읽어.",
          "gloss": "If you want to read a book, read at a desk.",
          "source": {
            "book": "textbook",
            "page": 118
          },
          "pronunciation": "Chaegeul ilgeuryeomyeon chaeksangeseo ilgeo."
        },
        {
          "id": "bike-goal",
          "term": "자전거를 잘 타려면 어떻게 해야 돼요?",
          "gloss": "What should I do if I want to ride a bicycle well?",
          "source": {
            "book": "textbook",
            "page": 118
          },
          "pronunciation": "Jajeongeoreul jal taryeomyeon eotteoke haeya dwaeyo?"
        }
      ],
      "questions": [
        {
          "id": "goal-condition-01",
          "modelId": "strong-goal",
          "explanation": "A desired goal and its required action use -(으)려면.",
          "formA": {
            "prompt": "If you want to become strong: ___ 운동을 해야 돼요.",
            "choices": [
              "튼튼해지려면",
              "튼튼해져도",
              "튼튼해지면서",
              "튼튼해졌기 때문에"
            ],
            "answer": "튼튼해지려면"
          },
          "formB": {
            "prompt": "If you want to get up early: 일찍 ___ 빨리 자야 돼요.",
            "choices": [
              "일어나도",
              "일어나면서",
              "일어났기 때문에",
              "일어나려면"
            ],
            "answer": "일어나려면"
          }
        },
        {
          "id": "goal-condition-02",
          "modelId": "read-goal",
          "explanation": "읽다 has a final consonant, so use 읽으려면; 입다 similarly takes 입으려면.",
          "formA": {
            "prompt": "If you want to read: 책을 ___ 책상에서 읽어요.",
            "choices": [
              "읽려면",
              "읽을려면",
              "읽으면려",
              "읽으려면"
            ],
            "answer": "읽으려면"
          },
          "formB": {
            "prompt": "If you want to wear your sister’s clothes: 언니 옷을 ___ 먼저 물어봐요.",
            "choices": [
              "입을려면",
              "입으면려",
              "입으려면",
              "입려면"
            ],
            "answer": "입으려면"
          }
        },
        {
          "id": "goal-condition-03",
          "modelId": "bike-goal",
          "explanation": "Use -려면 for the goal, rather than a cause or concession.",
          "formA": {
            "prompt": "If you want to ride well: 자전거를 잘 ___ 앞을 보세요.",
            "choices": [
              "타면서",
              "타도",
              "타려면",
              "탔기 때문에"
            ],
            "answer": "타려면"
          },
          "formB": {
            "prompt": "If you want to avoid a cold: 감기에 안 ___ 손을 잘 씻으세요.",
            "choices": [
              "걸려도",
              "걸리려면",
              "걸렸기 때문에",
              "걸리면서"
            ],
            "answer": "걸리려면"
          }
        }
      ]
    },
    {
      "id": "reason",
      "label": "-기 때문에",
      "explanation": "Use a verb or adjective stem + -기 때문에 for a reason: “because….” Past reasons use -았/었기 때문에; nouns take -(이)기 때문에. The reason precedes the result. Keep tense accurate, and distinguish a reason from a desired goal.",
      "source": {
        "book": "textbook",
        "page": 119
      },
