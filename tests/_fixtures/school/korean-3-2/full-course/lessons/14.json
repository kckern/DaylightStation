  "patterns": [
    {
      "id": "reported-suggestion",
      "label": "-재(요)",
      "explanation": "Report a suggestion with action verb + -재(요), the contraction of -자고 해(요). It means someone suggests doing something together, rather than reporting a command or statement. Use -지 말재요 for a negative suggestion.",
      "source": {
        "book": "textbook",
        "page": 148
      },
      "models": [
        {
          "id": "fishing-suggestion",
          "term": "아빠가 낚시를 하재요.",
          "gloss": "Dad suggests going fishing.",
          "source": {
            "book": "textbook",
            "page": 148
          },
          "pronunciation": "Appaga naksireul hajaeyo."
        },
        {
          "id": "grilling-suggestion",
          "term": "민지가 고기를 구워 먹재요.",
          "gloss": "Minji suggests grilling and eating meat.",
          "source": {
            "book": "textbook",
            "page": 148
          },
          "pronunciation": "Minjiga gogireul guwo meokjaeyo."
        },
        {
          "id": "tent-suggestion",
          "term": "아빠가 같이 텐트를 치재요.",
          "gloss": "Dad suggests putting up the tent together.",
          "source": {
            "book": "textbook",
            "page": 148
          },
          "pronunciation": "Appaga gachi tenteureul chijaeyo."
        }
      ],
      "questions": [
        {
          "id": "suggest-01",
          "modelId": "fishing-suggestion",
          "explanation": "하자 becomes 하재요 when reporting a suggestion.",
          "formA": {
            "prompt": "Dad said “Let’s fish.” 아빠가 낚시를 ___ .",
            "choices": [
              "하래요",
              "하느냬요",
              "하재요",
              "한대요"
            ],
            "answer": "하재요"
          },
          "formB": {
            "prompt": "Mom said “Let’s travel.” 엄마가 여행을 ___ .",
            "choices": [
              "가느냬요",
              "가재요",
              "간대요",
              "가래요"
            ],
            "answer": "가재요"
          }
        },
        {
          "id": "suggest-02",
          "modelId": "grilling-suggestion",
          "explanation": "A together-suggestion uses -재요, regardless of the stem-final consonant.",
          "formA": {
            "prompt": "Minji said “Let’s eat meat.” 민지가 고기를 ___ .",
            "choices": [
              "먹느냬요",
              "먹재요",
              "먹는대요",
              "먹으래요"
            ],
            "answer": "먹재요"
          },
          "formB": {
            "prompt": "Brother said “Let’s catch fish.” 형이 물고기를 ___ .",
            "choices": [
              "잡재요",
              "잡는대요",
              "잡으래요",
              "잡느냬요"
            ],
            "answer": "잡재요"
          }
        },
        {
          "id": "suggest-03",
          "modelId": "tent-suggestion",
          "explanation": "Report “Let’s…” with -재요 and “Let’s not…” with -지 말재요.",
          "formA": {
            "prompt": "Dad said “Let’s put up the tent.” 아빠가 텐트를 ___ .",
            "choices": [
              "치재요",
              "친대요",
              "치래요",
              "치느냬요"
            ],
            "answer": "치재요"
          },
          "formB": {
            "prompt": "Suji said “Let’s not go outside.” 수지가 밖에 ___ .",
            "choices": [
              "나가지 않는대요",
              "나가지 말래요",
              "나가지 않느냬요",
              "나가지 말재요"
            ],
            "answer": "나가지 말재요"
          }
        }
      ]
    },
    {
      "id": "reported-question",
      "label": "-느냬(요)/(으)냬(요)",
      "explanation": "Report a question: action verbs take -느냬(요); adjectives take -(으)냬(요), with -으냬 after a consonant and -냬 after a vowel. Past questions take -았/었냬(요). These contract reported questions with -냐고 해(요). For this course, 있다/없다 use -느냬(요), as in 시간이 있느냬요, rather than the ordinary adjective ending.",
      "source": {
        "book": "textbook",
        "page": 149
      },
      "models": [
        {
          "id": "travel-question",
          "term": "방학에 어디로 여행을 가느냬요?",
          "gloss": "They ask where we are traveling during the vacation.",
