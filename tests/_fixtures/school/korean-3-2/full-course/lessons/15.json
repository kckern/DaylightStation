  "patterns": [
    {
      "id": "embedded-question",
      "label": "-는지 알다/모르다",
      "explanation": "Embed an information question before 알다/모르다: present action verbs use -는지. Past actions use -았/었는지; adjective stems use -(으)ㄴ지, and nouns use -인지. The question word remains inside the embedded clause. 있다/없다 are exceptions to ordinary adjective forms: use 있는지/없는지.",
      "source": {
        "book": "textbook",
        "page": 138
      },
      "models": [
        {
          "id": "closing-time",
          "term": "몇 시에 스케이트장 문을 닫는지 알아?",
          "gloss": "Do you know what time the skating rink closes?",
          "source": {
            "book": "textbook",
            "page": 138
          },
          "pronunciation": "Myeot sie seukeiteujang muneul danneunji ara?"
        }
      ],
      "questions": [
        {
          "id": "review-know-01",
          "modelId": "closing-time",
          "explanation": "Present action questions embed -는지 before 알다/모르다.",
          "formA": {
            "prompt": "Ask if they know when vacation starts: 방학이 언제 ___?",
            "choices": [
              "시작해 봤어요",
              "시작하는지 알아요",
              "시작하는 것을 좋아해요",
              "시작하재요"
            ],
            "answer": "시작하는지 알아요"
          },
          "formB": {
            "prompt": "Ask if they know how long the flight takes: 비행기로 얼마나 ___?",
            "choices": [
              "걸리는지 알아요",
              "걸리는 것을 좋아해요",
              "걸리재요",
              "걸려 봤어요"
            ],
            "answer": "걸리는지 알아요"
          }
        },
        {
          "id": "review-know-02",
          "modelId": "closing-time",
          "explanation": "Use the appropriate embedded past or present question, then 몰라요.",
          "formA": {
            "prompt": "I do not know who drew this picture: 이 그림을 누가 ___ .",
            "choices": [
              "그렸는지 몰라요",
              "그리는 것을 좋아해요",
              "그리재요",
              "그려 봤어요"
            ],
            "answer": "그렸는지 몰라요"
          },
          "formB": {
            "prompt": "I do not know where Thomas lives: 토마스가 어디에 ___ .",
            "choices": [
              "사는 것을 좋아해요",
              "살재요",
              "살아 봤어요",
              "사는지 몰라요"
            ],
            "answer": "사는지 몰라요"
          }
        }
      ]
    },
    {
      "id": "action-noun",
      "label": "-는 것",
      "explanation": "Use present action verb + -는 것 to turn an action into a noun phrase, or to refer to the thing someone does. Add particles to 것: 것이 for the subject and 것을 for the object. Adjectives instead take -(으)ㄴ 것, and nouns take -인 것.",
      "source": {
        "book": "textbook",
        "page": 139
      },
      "models": [
        {
          "id": "singing",
          "term": "저는 노래 부르는 것을 좋아해요.",
          "gloss": "I like singing.",
          "source": {
            "book": "textbook",
            "page": 139
          },
          "pronunciation": "Jeoneun norae bureuneun geoseul joahaeyo."
        }
      ],
      "questions": [
        {
          "id": "review-thing-01",
          "modelId": "singing",
          "explanation": "Use -는 것을 as the object for the activity someone likes.",
          "formA": {
            "prompt": "I like taking photos: 저는 사진 ___ .",
            "choices": [
              "찍는 것을 좋아해요",
              "찍는지 알아요",
              "찍을까 봐 걱정해요",
              "찍재요"
            ],
            "answer": "찍는 것을 좋아해요"
          },
          "formB": {
            "prompt": "I like raising a puppy: 저는 강아지 ___ .",
            "choices": [
              "기르는지 알아요",
              "기를까 봐 걱정해요",
              "기르재요",
              "기르는 것을 좋아해요"
            ],
            "answer": "기르는 것을 좋아해요"
          }
        },
        {
          "id": "review-thing-02",
          "modelId": "singing",
          "explanation": "Use 보는 것이 and 쓰는 것이 to make watching/writing the grammatical subject. -느라고 instead gives an occupying action as a cause, which is not the requested noun expression.",
          "formA": {
            "prompt": "Make watching the subject: 자막 없이 ___ 힘들어요. (watching is difficult)",
            "choices": [
              "보는지",
              "보느라고",
              "보재요",
              "보는 것이"
            ],
            "answer": "보는 것이"
          },
          "formB": {
            "prompt": "Make writing the subject: 팔을 다쳐서 글을 ___ 힘들어요. (writing is difficult)",
            "choices": [
              "쓰느라고",
              "쓰재요",
              "쓰는 것이",
              "쓰는지"
            ],
            "answer": "쓰는 것이"
          }
        }
      ]
    },
    {
      "id": "reported-suggestion",
      "label": "-재(요)",
      "explanation": "Report a suggestion with action verb + -재(요), the contraction of -자고 해(요). It means someone suggests doing something together, rather than reporting a command or statement. Use -지 말재요 for a negative suggestion.",
