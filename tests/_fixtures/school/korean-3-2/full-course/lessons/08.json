  "patterns": [
    {
      "id": "appearance",
      "label": "-아/어 보이다",
      "explanation": "Use an adjective with -아/어 보이다 to describe how someone or something looks or seems from observation, rather than stating a known fact. 하다 adjectives become -해 보이다; apply irregular changes (춥다 → 추워). 보여요 is polite; 보여 is familiar.",
      "source": {
        "book": "textbook",
        "page": 88
      },
      "models": [
        {
          "id": "good-mood",
          "term": "기분이 좋아 보여.",
          "gloss": "You look like you are in a good mood.",
          "source": {
            "book": "textbook",
            "page": 88
          },
          "pronunciation": "Gibuni joa boyeo."
        },
        {
          "id": "movie-interest",
          "term": "재미있어 보여.",
          "gloss": "It looks interesting.",
          "source": {
            "book": "textbook",
            "page": 88
          },
          "pronunciation": "Jaemiisseo boyeo."
        },
        {
          "id": "cold-look",
          "term": "너무 추워 보여.",
          "gloss": "You look very cold.",
          "source": {
            "book": "textbook",
            "page": 88
          },
          "pronunciation": "Neomu chuwo boyeo."
        }
      ],
      "questions": [
        {
          "id": "appearance-01",
          "modelId": "good-mood",
          "explanation": "좋아 보여요 describes an observed impression, rather than a reported fact.",
          "formA": {
            "prompt": "You look cheerful: 기분이 ___.",
            "choices": [
              "좋아 보여요",
              "좋았대요",
              "좋아야 돼요",
              "좋으면 좋겠어요"
            ],
            "answer": "좋아 보여요"
          },
          "formB": {
            "prompt": "This pizza looks tasty: 피자가 ___.",
            "choices": [
              "맛있었대요",
              "맛있어야 돼요",
              "맛있으면 좋겠어요",
              "맛있어 보여요"
            ],
            "answer": "맛있어 보여요"
          }
        },
        {
          "id": "appearance-02",
          "modelId": "movie-interest",
          "explanation": "재미있다 → 재미있어 보이다; 지루하다 → 지루해 보이다.",
          "formA": {
            "prompt": "The movie looks interesting: 영화가 ___ 보여요.",
            "choices": [
              "재미있아",
              "재미있는",
              "재미있으면",
              "재미있어"
            ],
            "answer": "재미있어"
          },
          "formB": {
            "prompt": "The performance looks boring: 공연이 ___ 보여요.",
            "choices": [
              "지루한",
              "지루하면",
              "지루해",
              "지루하아"
            ],
            "answer": "지루해"
          }
        },
        {
          "id": "appearance-03",
          "modelId": "cold-look",
          "explanation": "Apply adjective irregulars before 보이다: 춥다 → 추워; 어렵다 → 어려워.",
          "formA": {
            "prompt": "You look cold: ___ 보여요.",
            "choices": [
              "추운",
              "추우면",
              "추워",
              "춥어"
            ],
            "answer": "추워"
          },
          "formB": {
            "prompt": "The problem looks difficult: 문제가 ___ 보여요.",
            "choices": [
              "어려우면",
              "어려워",
              "어렵어",
              "어려운"
            ],
            "answer": "어려워"
          }
        }
      ]
    },
    {
      "id": "simultaneous",
      "label": "-(으)면서",
      "explanation": "Use -(으)면서 for two actions happening at the same time, usually by the same subject. Add -으면서 after a consonant and -면서 after a vowel or ㄹ. 듣다 becomes 들으면서. The final verb carries tense and politeness.",
      "source": {
        "book": "textbook",
        "page": 89
      },
      "models": [
        {
          "id": "music-book",
          "term": "음악을 들으면서 책을 읽을 거예요.",
