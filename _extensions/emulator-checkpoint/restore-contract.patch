+
+/* Synchronous, paused restore: return the core's deserialize result itself,
+ * never the task-queue submission/old load_state rv echo. */
+EMSCRIPTEN_KEEPALIVE int daylight_checkpoint_contract_version(void) { return 1; }
+EMSCRIPTEN_KEEPALIVE int daylight_enable_checkpoint_protection_v1(void)
+{
+   if (!ejs_is_paused() || content_load_state_in_progress(NULL)) return 0;
+   daylight_checkpoint_protected = true;
+   return 1;
+}
+EMSCRIPTEN_KEEPALIVE int daylight_restore_pending_v1(void)
+{
+   return content_load_state_in_progress(NULL) ? 1 : 0;
+}
+/* Validate the container before the upstream parser examines its blocks. */
+static bool daylight_state_envelope(const unsigned char *bytes, size_t size)
+{
+   size_t offset = 8;
+   bool core = false;
+   if (size < 8) return false;
+   if (memcmp(bytes, "RASTATE", 7) != 0) return true; /* raw core format */
+   if (bytes[7] != 1) return false;
+   while (offset <= size && size - offset >= 8)
+   {
+      const unsigned char *block = bytes + offset;
+      size_t length = (uint32_t)block[4] | ((uint32_t)block[5] << 8)
+         | ((uint32_t)block[6] << 16) | ((uint32_t)block[7] << 24);
+      offset += 8;
+      if (memcmp(block, "END ", 4) == 0) return core && !length && offset == size;
+      if (length > size - offset) return false;
+      if (memcmp(block, "MEM ", 4) == 0) { if (core || !length) return false; core = true; }
+      length = CONTENT_ALIGN_SIZE(length);
+      if (length > size - offset) return false;
+      offset += length;
+   }
+   return false;
+}
+EMSCRIPTEN_KEEPALIVE unsigned daylight_restore_last_request_v1(void)
+{
+   return daylight_last_request;
+}
+EMSCRIPTEN_KEEPALIVE int daylight_checkpoint_is_protected_v1(void)
+{
+   return daylight_checkpoint_protected;
+}
+EMSCRIPTEN_KEEPALIVE int daylight_restore_state_v1(const char *path, unsigned request)
+{
+   void *bytes = NULL;
+   int64_t size = 0;
+   bool restored = false;
+   if (!request || !daylight_checkpoint_protected || !ejs_is_paused()) return 0;
+   daylight_last_request = request;
+   if (filestream_read_file(path, &bytes, &size) && size >= 8 && size <= 8388608
+         && daylight_state_envelope((const unsigned char*)bytes, (size_t)size))
+      restored = content_deserialize_state(bytes, (size_t)size);
+   free(bytes);
+   return restored ? 1 : 0;
+}
+EMSCRIPTEN_KEEPALIVE uintptr_t daylight_memory_data_v1(unsigned type)
+{
+   retro_ctx_memory_info_t info;
+   memset(&info, 0, sizeof(info)); info.id = type; core_get_memory(&info);
+   return (uintptr_t)info.data;
+}
+EMSCRIPTEN_KEEPALIVE size_t daylight_memory_size_v1(unsigned type)
+{
+   retro_ctx_memory_info_t info;
+   memset(&info, 0, sizeof(info)); info.id = type; core_get_memory(&info);
+   return info.size;
+}
+EMSCRIPTEN_KEEPALIVE int daylight_restore_battery_v1(const char *path, unsigned request)
+{
+   void *bytes = NULL;
+   int64_t size = 0;
+   bool restored = false;
+   retro_ctx_memory_info_t info;
+   if (!request || !daylight_checkpoint_protected || !ejs_is_paused()) return 0;
+   daylight_last_request = request;
+   if (strcmp(path, save_file_path()) != 0) return 0;
+   memset(&info, 0, sizeof(info)); info.id = RETRO_MEMORY_SAVE_RAM; core_get_memory(&info);
+   if (info.data && info.size && filestream_read_file(path, &bytes, &size)
+         && size > 0 && (uint64_t)size == info.size)
+   {
+      event_load_save_files(false);
+      restored = memcmp(info.data, bytes, info.size) == 0;
+   }
+   free(bytes);
+   return restored ? 1 : 0;
 }
 
 #endif
