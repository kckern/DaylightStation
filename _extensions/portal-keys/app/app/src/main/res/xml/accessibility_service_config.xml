<?xml version="1.0" encoding="utf-8"?>
<!-- Key interception requires canRequestFilterKeyEvents="true" AND
     flagRequestFilterKeyEvents in accessibilityFlags. Declaring only one of the two
     yields a service that binds fine but never receives onKeyEvent — with no error
     anywhere. Both are load-bearing.

     typeWindowsChanged + flagRetrieveInteractiveWindows exist ONLY to auto-dismiss
     Portal's swipe-up Control Center. MEASURED 2026-07-21: that panel is NOT_FOCUSABLE
     (ty=KEYGUARD_DIALOG), so it never fires typeWindowStateChanged — typeWindowsChanged is
     the only event that reports it. getWindows() returns an empty list without
     flagRetrieveInteractiveWindows, and Android refuses that flag unless
     canRetrieveWindowContent is true, which is why that flipped from false. All three move
     together; drop any one and the dismissal silently never fires.
     typeWindowStateChanged lets the narrowly scoped self-updater see Android's
     Package Installer confirmation during its brief foreground window.
     See PortalKeysService.onAccessibilityEvent and OwnUpdateConfirmation.

     canRetrieveWindowContent grants the ability to read screen content. Normal operation
     reads only window bounds/types. Node text is inspected only while the bounded,
     package-scoped Portal Keys installer confirmation flow is pending. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibility_service_description"
    android:accessibilityEventTypes="typeWindowsChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRequestFilterKeyEvents="true"
    android:accessibilityFlags="flagRequestFilterKeyEvents|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:notificationTimeout="0" />
