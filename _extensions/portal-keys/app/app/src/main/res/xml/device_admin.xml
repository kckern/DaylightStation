<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies><force-lock /></uses-policies>
    <!-- Lets DevicePolicyManager.transferOwnership (API 28) hand ownership TO this app.
         The framework checks this tag on the receiving admin, so it matters for a
         transfer back from the replacement app, not for the outgoing one. -->
    <support-transfer-ownership />
</device-admin>
