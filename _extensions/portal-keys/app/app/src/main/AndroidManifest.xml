<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="net.kckern.portalkeys">

    <!-- INTERNET: the control plane (NanoWSD on :8771) binds a listening socket —
         localhost for the kiosk SPA, LAN for the pkctl CLI. Also used for the FKB
         REST calls that drive the backlight. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ADB-FREE OPERATIONS. ADB-over-WiFi does NOT survive a reboot on this panel and
         cannot be made to: `adb root` is refused (production build) and
         `setprop persist.adb.tcp.port` needs root. So rather than persist ADB, we make it
         unnecessary. Both of these are granted ONCE over USB and then survive reboots:

           appops set net.kckern.portalkeys REQUEST_INSTALL_PACKAGES allow
           pm grant  net.kckern.portalkeys android.permission.READ_LOGS

         REQUEST_INSTALL_PACKAGES → POST /update installs a new APK from a URL.
         READ_LOGS                → GET /logcat returns our own log lines, so a failure
                                    can be diagnosed without a shell. -->
    <!-- BLUETOOTH / BLUETOOTH_ADMIN are INSTALL-TIME on API 28 (this panel is
         Android 9), so there is no runtime grant and nothing to re-approve after
         a reboot. BLUETOOTH_CONNECT (Android 12) does not apply at targetSdk 28.

         ACCESS_COARSE_LOCATION is required for BLE SCANNING on API 23-28 — a
         scan silently returns zero results without it, which is exactly the
         symptom being diagnosed here. It is NOT needed to read connected
         devices or bonded devices, only to discover new ones. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.DUMP" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- usesCleartextTraffic: FKB's REST API is plain http on :2323. Android 9 (API 28)
         BLOCKS cleartext by default once targetSdk >= 28, so without this every call to
         FKB fails before leaving the process — which is exactly what happened: the
         double-press gesture fired correctly and `screen-off ok=false` came back on both
         127.0.0.1 and the LAN address, while the identical URL worked from a laptop.
         There is no https option on FKB, so opting in is the only route. -->
    <application
        android:label="Portal Keys"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".PortalBridgeService" android:exported="false" />

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
            <intent-filter><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
        <receiver android:name=".UpdateResultReceiver" android:exported="false" />

        <!-- AccessibilityService is bound by the SYSTEM. No launcher activity, no
             BootReceiver, no foreground service: the system rebinds it after reboot
             on its own, provided the grant in Settings -> Accessibility survives.

             BIND_ACCESSIBILITY_SERVICE is required on the <service> itself, and the
             key-filtering capability is declared in res/xml/accessibility_service_config
             (canRequestFilterKeyEvents + flagRequestFilterKeyEvents). ALL THREE are
             needed — omitting any one makes onKeyEvent never fire, SILENTLY. -->
        <service
            android:name=".PortalKeysService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
