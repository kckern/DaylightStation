<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed for a media foreground service from target 34; declared now so a later
         target bump is a config change. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The same, for the downloads service (dataSync) from target 34. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <queries>
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <application>
        <!-- Exported: a car (Android Auto), the system's media controls and Bluetooth reach
             it by binding it, and no permission exists that only they hold. So any app can
             try: who is accepted is decided per connection (ControllerPolicy: this app, the
             system, and a fixed list of car and assistant apps). A controller hands over
             media ids only; what an id plays is the payload's answer from the backend.
             The second action is the platform browser interface those clients use. -->
        <service
            android:name="net.kckern.daylight.cap.mediaservice.shell.DaylightMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- A media button (a headset, a car, the system's resume card) wakes the service when
             it is not running. Media3's receiver finds the library service above and starts it;
             onPlaybackResumption then picks up the last item played. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Not exported: started only by this app's own widget buttons (an immutable
             PendingIntent.getForegroundService) and tiles, with one action id. It plays a
             configured or pinned media action with no window. -->
        <service
            android:name="net.kckern.daylight.cap.mediaservice.shell.PlayActionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Not exported: downloads kept on this phone ("Keep on this phone", KeepStore).
             Started only by this app's own Now playing menu; Media3's DownloadService runs
             in the foreground with a progress notification while it works. -->
        <service
            android:name="net.kckern.daylight.cap.mediaservice.shell.KeepService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Not exported: only the system's job scheduler binds these. KeepJob keeps the
             phone's downloads in line with what is kept, app closed (a keep from the web, a
             retry that is due, a daily re-sync of kept playlists on Wi-Fi). Media3's
             scheduler starts KeepService when downloads waiting on Wi-Fi or storage can go on. -->
        <service android:name="net.kckern.daylight.cap.mediaservice.shell.KeepJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service android:name="androidx.media3.exoplayer.scheduler.PlatformScheduler$PlatformSchedulerService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Not exported: the phone as a remote for one screen's session (a second Media3
             session beside the one above). Bound by this app's Now playing screen; the
             system reaches it only through its media notification. The action lets a
             SessionToken find it; with exported="false" no other app can bind it. -->
        <service
            android:name="net.kckern.daylight.cap.mediaservice.shell.RemoteControlService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Not exported: the Now playing screen, for this phone's playback or a screen's.
             Opened by this app only: the setup screen, a player: one-tap action through the
             payload, and both media notifications. -->
        <activity
            android:name="net.kckern.daylight.cap.mediaservice.shell.NowPlayingActivity"
            android:exported="false"
            android:label="Now playing"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Daylight" />

        <!-- Not exported: started by this app only, when the payload has accepted a keyed
             media link. No window of its own. -->
        <activity
            android:name="net.kckern.daylight.cap.mediaservice.shell.PlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
