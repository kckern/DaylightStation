<?xml version="1.0" encoding="utf-8"?>
<!-- View tags the library pages read: a row's media id (Back to the list scrolls to it). -->
<resources>
    <item name="daylight_browse_row_id" type="id" />
    <item name="daylight_keep_bar_attempt" type="id" />
    <!-- A row's "More options for <title>" accessibility action (its long-press sheet). -->
    <item name="daylight_browse_row_menu" type="id" />
    <!-- A Now playing control that drags by itself (seek bar, queue drag handle, D-pad):
         a downward drag that starts on it never closes the screen (DismissGesture). -->
    <item name="daylight_np_own_drag" type="id" />
    <!-- The chapter rail's TalkBack actions (ChapterRailView). -->
    <item name="daylight_rail_previous" type="id" />
    <item name="daylight_rail_next" type="id" />
</resources>
