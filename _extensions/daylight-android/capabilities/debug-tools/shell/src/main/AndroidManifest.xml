<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- signature|privileged|development: granted once per device with `pm grant`.
         Without the grant the routes still answer, seeing only this app's own logs. -->
    <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.DUMP" tools:ignore="ProtectedPermissions" />
</manifest>
