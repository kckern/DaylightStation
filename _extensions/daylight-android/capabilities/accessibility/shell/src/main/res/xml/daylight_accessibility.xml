<?xml version="1.0" encoding="utf-8"?>
<!-- Flags: the piano bridge's. Capabilities: the union of piano-bridge and portal-keys.
     Key-event filtering and extra event types are switched on at run time by
     AccessibilityHub when a capability asks for them. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/daylight_accessibility_desc"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="0"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="true"
    android:canRequestTouchExplorationMode="true"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagRetrieveInteractiveWindows" />
