<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The meal photo camera (MealCameraActivity). Asked for once, in the camera screen itself; if it
         is refused the capture opens the phone's camera app instead. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Needed for a microphone foreground service from target 34; declared now so a
         later target bump is a config change. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- Not exported: started by this app only, when the payload has accepted a keyed
             memo link, or from the recording's own notification. Opening it is what starts
             a recording, so nothing outside this app may open it. -->
        <activity
            android:name="net.kckern.daylight.cap.quickinput.shell.RecordActivity"
            android:showWhenLocked="true"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="Voice memo"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.Dialog" />

        <!-- Not exported: started by this app only, when the payload has accepted a keyed
             input link. Typed text leaves it only on Send. Kept out of the recents list, and
             not shown over the lock screen (it never asks to be). -->
        <activity
            android:name="net.kckern.daylight.cap.quickinput.shell.TextInputActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="Quick input"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.Dialog"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- Not exported: started by this app only, when the payload has accepted a keyed
             input link. Opening it opens the system's camera app, so nothing outside this
             app may open it. The owner reviews the confirmed capture in this window. -->
        <!-- Not exported: started by this app only, from a keyed photo link. A viewfinder and a
             shutter; each shot goes to the private draft queue with no review step. -->
        <activity
            android:name="net.kckern.daylight.cap.quickinput.shell.MealCameraActivity"
            android:showWhenLocked="true"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:label="Photo"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <activity
            android:name="net.kckern.daylight.cap.quickinput.shell.PhotoCaptureActivity"
            android:showWhenLocked="true"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:label="Photo"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.Dialog" />

        <!-- Exported, no permission: Daylight in Android's share sheet. Another app's share
             (plain text: a link, a title around it) opens it; nothing is sent until the owner
             taps where it goes, and it is written into the private quick-input queue like a
             typed note. Not over the lock screen. See ShareActivity. -->
        <activity
            android:name="net.kckern.daylight.cap.quickinput.shell.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Daylight"
            android:launchMode="standard"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.Dialog">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Not exported: only the system's job scheduler binds it. Sends a queued capture after the app was stopped. -->
        <service
            android:name="net.kckern.daylight.cap.quickinput.shell.UploadJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name="net.kckern.daylight.cap.quickinput.shell.CaptureStatusActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="Capture status"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Not exported. Gives the camera app the one file a capture is written to, by a
             grant the photo screen makes for that file alone; grants can be made for
             /capture/ and for nothing else. See InputFileProvider and CaptureFiles.served. -->
        <provider
            android:name="net.kckern.daylight.cap.quickinput.shell.InputFileProvider"
            android:authorities="${applicationId}.inputs"
            android:exported="false"
            android:grantUriPermissions="false">
            <grant-uri-permission android:pathPrefix="/capture/" />
        </provider>

        <!-- Not exported: started and stopped by this app only. A foreground service of
             type microphone, with a notification for as long as it records. -->
        <service
            android:name="net.kckern.daylight.cap.quickinput.shell.MemoRecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
