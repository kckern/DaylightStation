<?xml version="1.0" encoding="utf-8"?>
<!-- Only LinearLayout and TextView: both are on the list of views RemoteViews can inflate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="4dp">

    <TextView android:id="@+id/slot1" android:textAppearance="@android:style/TextAppearance.Material.Button"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_margin="2dp" android:gravity="center" android:maxLines="2"
        android:background="#CC202124" android:textColor="#FFFFFFFF" />

    <TextView android:id="@+id/slot2" android:textAppearance="@android:style/TextAppearance.Material.Button"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_margin="2dp" android:gravity="center" android:maxLines="2"
        android:background="#CC202124" android:textColor="#FFFFFFFF" />

    <TextView android:id="@+id/slot3" android:textAppearance="@android:style/TextAppearance.Material.Button"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_margin="2dp" android:gravity="center" android:maxLines="2"
        android:background="#CC202124" android:textColor="#FFFFFFFF" />

    <TextView android:id="@+id/slot4" android:textAppearance="@android:style/TextAppearance.Material.Button"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_margin="2dp" android:gravity="center" android:maxLines="2"
        android:background="#CC202124" android:textColor="#FFFFFFFF" />
</LinearLayout>
