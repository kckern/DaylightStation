<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis 0: the payload pushes an update whenever the actions change, and
     the platform would not deliver timed ones more often than every 30 minutes anyway. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_actions"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen" />
