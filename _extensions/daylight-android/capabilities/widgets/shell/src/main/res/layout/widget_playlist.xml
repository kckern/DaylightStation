<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playlist_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <FrameLayout
            android:id="@+id/playlist_cover_frame"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/widget_playlist_cover_background"
            android:clipToOutline="true"
            android:importantForAccessibility="noHideDescendants">
            <ImageView
                android:id="@+id/playlist_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_playlist_cover" />
            <ProgressBar
                android:id="@+id/playlist_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:minHeight="0dp"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="4dp"
                android:progressTint="#F0FFFFFF"
                android:progressBackgroundTint="#80000000"
                android:visibility="gone" />
            <TextView
                android:id="@+id/playlist_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:background="#A0000000"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingHorizontal="3dp"
                android:textColor="#F0FFFFFF"
                android:textSize="9sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/playlist_track_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="#A0000000"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingHorizontal="3dp"
                android:textColor="#F0FFFFFF"
                android:textSize="9sp"
                android:visibility="gone" />
        </FrameLayout>
        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="-6dp"
            android:background="@drawable/widget_playlist_badge"
            android:importantForAccessibility="noHideDescendants">
            <ImageView
                android:id="@+id/playlist_action"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:src="@android:drawable/ic_media_play" />
            <ProgressBar
                android:id="@+id/playlist_loading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone" />
            <ViewFlipper
                android:id="@+id/playlist_motion"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="80"
                android:visibility="gone">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="5dp" android:src="@drawable/widget_sound_wave_00" />
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="5dp" android:src="@drawable/widget_sound_wave_01" />
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="5dp" android:src="@drawable/widget_sound_wave_02" />
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="5dp" android:src="@drawable/widget_sound_wave_03" />
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="5dp" android:src="@drawable/widget_sound_wave_04" />
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="5dp" android:src="@drawable/widget_sound_wave_05" />
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="5dp" android:src="@drawable/widget_sound_wave_06" />
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="5dp" android:src="@drawable/widget_sound_wave_07" />
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="5dp" android:src="@drawable/widget_sound_wave_08" />
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="5dp" android:src="@drawable/widget_sound_wave_09" />
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="5dp" android:src="@drawable/widget_sound_wave_10" />
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="5dp" android:src="@drawable/widget_sound_wave_11" />
            </ViewFlipper>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
