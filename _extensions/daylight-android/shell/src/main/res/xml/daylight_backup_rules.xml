<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier (android:fullBackupContent). Nothing the app keeps is backed
     up: the link key, the settings overrides and a queued recording stay on the device
     they were made on. allowBackup is false as well; this file says the same thing to a
     device that backs up regardless. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
