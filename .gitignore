/_extensions/portal-keys/app/app/build
/_extensions/portal-keys/app/.gradle
/_extensions/portal-keys/app/local.properties

# ESP-IDF fetched dependencies (~165 MB). The component manager refetches these
# from dependencies.lock, which IS tracked and pins exact versions + hashes, so
# a fresh clone reproduces the same tree with `idf.py reconfigure`.
/_extensions/food-scale-relay/firmware/managed_components/
/_extensions/food-scale-relay/firmware/build/

# Extension config TEMPLATES. These document each extension's schema and are
# meant to be committed — the global `*.yml` rule at the top was hiding them,
# which is the whole point of an example file defeated. The REAL configs stay
# in the household data volume and are still ignored.
!/_extensions/content-barcode-relay/config.example.yml
!/_extensions/ir-blaster/config.example.yml

# Golden-test failure artifacts (regenerated on every failing run, never source)
tests/isolated/rendering/school/golden/snapshots/*.diff.png

# Agent scratch probes at repo root
/_scratch/

# Mutation-test scratch modules (tests/isolated/e2e/school/sabotage.test.mjs writes
# a patched sibling of a real module and deletes it; this catches a crashed run).
__sabotage_*.mjs

# `npm run sheet` writes ./<sheet-id>.pdf by default. The PDF is a build product of
# sheets.yml + scales.yml and is not byte-stable anyway (pdfkit stamps a creation
# date), so committing it would churn on every regeneration.
/*.pdf
/.agents
# Committed visual baselines the print-design acceptance sweeps compare against
# (they write a fresh one and FAIL when it is missing, so it must be tracked).
# Every other proof render is scratch output.
__app_modules/learning/school/server/application/documents/__proof__/**/*.png
!__app_modules/learning/school/server/application/documents/__proof__/phase-a/proof-standard-p02.png
!__app_modules/learning/school/server/application/documents/__proof__/phase-b/kitchen-sink-student-p01.png
!__app_modules/learning/school/server/application/documents/__proof__/phase-c/card-continuation-student-p01.png
__app_modules/learning/school/server/application/documents/__proof__/**/*.pdf

# TI-86 install images are BUILD OUTPUT, regenerable by tools/build-*-install.mjs.
# 31MB of binaries, and the .86s payloads carry learner identities baked in at
# build time — neither belongs in a public repo.
_extensions/ti86-app/dist/
__app_modules/*/*/satellites/**/dist/
__app_modules/*/*/satellites/**/build/
__app_modules/*/*/satellites/**/node_modules/
**/.pio/
**/.gradle/
**/.cxx/
**/local.properties
/tmp

# Screenshots and scratch captures. This repo is public and screenshots of a
# running household kiosk show real names, schedules and telemetry as PIXELS —
# which no text scrub or push guard can see. 88 such files (19MB of audit and
# extension-doc captures) were removed on 2026-09-01.
#
# Deliberately NOT a blanket *.png ban: it would silently stop `git add` on
# regenerated golden snapshots (tests/isolated/rendering/school/golden/) and on
# the favicon set, both of which are functional. Keep bitmaps to those two
# places and to tests/_fixtures/; put anything else here.
.playwright-mcp/

# Playwright screenshot artifacts (visual gates)
tests/_artifacts/

# Scratch analysis output and room recordings: household telemetry, regenerable
# from the source capture.
recording-analysis/
*.wav

# Personal data authoring and one-off root probes belong outside the code tree.
/data-drafts/
/media/
/molecules-review/
/js.json
/swap-test.mjs

