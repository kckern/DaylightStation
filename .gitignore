# Portal Keys Android build outputs — same treatment as audio-bridge above.
# (Superseded three reactive per-subdirectory rules that only covered whichever
# intermediates happened to churn; the whole build tree is generated.)
/_extensions/portal-keys/app/app/build
/_extensions/portal-keys/app/.gradle
/_extensions/portal-keys/app/local.properties

# ESP-IDF fetched dependencies (~165 MB). The component manager refetches these
# from dependencies.lock, which IS tracked and pins exact versions + hashes, so
# a fresh clone reproduces the same tree with `idf.py reconfigure`.
/_extensions/food-scale-relay/firmware/managed_components/
/_extensions/food-scale-relay/firmware/build/
# ...but the refetch ALSO needs the manifest, and the global `*.yml` rule at the
# top of this file was swallowing it. Without this negation a fresh clone gets
# the lock and no manifest, and the firmware cannot be built at all.
!/_extensions/food-scale-relay/firmware/src/idf_component.yml

# Extension config TEMPLATES. These document each extension's schema and are
# meant to be committed — the global `*.yml` rule at the top was hiding them,
# which is the whole point of an example file defeated. The REAL configs stay
# in the household data volume and are still ignored.
!/_extensions/content-barcode-relay/config.example.yml
!/_extensions/ir-blaster/config.example.yml
!/_extensions/piano/recorder/config.example.yml

# Golden-test failure artifacts (regenerated on every failing run, never source)
tests/isolated/rendering/school/golden/snapshots/*.diff.png

# Agent scratch probes at repo root
/_scratch/

# Mutation-test scratch modules (tests/isolated/e2e/school/sabotage.test.mjs writes
# a patched sibling of a real module and deletes it; this catches a crashed run).
__sabotage_*.mjs

# `npm run sheet` writes ./<sheet-id>.pdf by default. The PDF is a build product of
# sheets.yml + scales.yml and is not byte-stable anyway (pdfkit stamps a creation
# date), so committing it would churn on every regeneration.
/*.pdf
docs/_moveme/
/.agents
!scripts/migrate-household-config.mjs
*.png
!tests/isolated/rendering/school/golden/snapshots/answer-sheet-*.png

# TI-86 install images are BUILD OUTPUT, regenerable by tools/build-*-install.mjs.
# 31MB of binaries, and the .86s payloads carry learner identities baked in at
# build time — neither belongs in a public repo.
_extensions/ti86-app/dist/
/tmp
