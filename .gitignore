# Rubik's Cube course content — `courseCatalog.mjs` degrades gracefully when
# this is absent (no throw at import), but a real one authored here must be
# committable rather than silently swallowed by the blanket `*.yml` rule.
!backend/src/3_applications/school/rubiksCube/course.yml
# Backend-scoped fixture tree (mirrors the `!tests/_fixtures/**` rule above for
# the root suite). These ARE test inputs — without this the suite only passes on
# a machine where they happen to sit untracked in the working tree.
!backend/tests/_fixtures/**/*.yml
# Golden-page corpus: these ARE the test inputs. Without this the suite passes
# only on a machine where they happen to sit untracked in the working tree.
!tests/isolated/rendering/school/golden/corpus/*.yml
